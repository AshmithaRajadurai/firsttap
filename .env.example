# ========================================================
# FirstTap - Voice-First Digital Literacy Companion
# Environment Configuration
# ========================================================

# Sarvam AI API Key (Used for Indian-language Speech-to-Text & Text-to-Speech)
# If left empty or omitted, FirstTap will gracefully use the browser Web Speech API
# and built-in voice synthesizer with zero crashes.
SARVAM_API_KEY=your_sarvam_api_key_here

# LLM API Key (Used for spontaneous digital literacy doubt resolution)
# If omitted, FirstTap uses its built-in verified cybersecurity & digital safety response engine.
GEMINI_API_KEY=your_gemini_api_key_here

# Application Metadata
NEXT_PUBLIC_APP_NAME=FirstTap
